generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id               String              @id @default(uuid())
  email            String              @unique
  penName          String              // e.g. "Velvet Wanderer"
  penTag           String              @unique // e.g. "scribe_942"
  avatarIcon       String              @default("feather") // feather, moon, star, flame, compass, book, mask, sparkle
  avatarColor      String              @default("amber") // amber, indigo, emerald, rose, violet, cyan
  bio              String?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  stories          Story[]
  reactions        Reaction[]
  comments         Comment[]
  bookmarks        Bookmark[]
  sentWhispers     WhisperConnection[] @relation("SentWhispers")
  receivedWhispers WhisperConnection[] @relation("ReceivedWhispers")
  messages         WhisperMessage[]
}

model Story {
  id              String       @id @default(uuid())
  slug            String       @unique
  title           String
  excerpt         String
  content         String       @db.Text
  mood            String       @default("Vulnerable") // Vulnerable, Nostalgic, Confessional, Hopeful, Cathartic, Poetic, Bittersweet
  circleCategory  String       @default("midnight-confessions") // midnight-confessions, unspoken-love, healing-grief, career-burnout, secret-dreams, family-ties, late-musings
  tags            String[]     @default([])
  coverTheme      String       @default("twilight-ink") // twilight-ink, parchment-gold, crimson-velvet, emerald-solitude, amethyst-haze
  readTimeMinutes Int          @default(3)
  isDraft         Boolean      @default(false)
  isGhostMode     Boolean      @default(false) // If true, shows "Nameless Scribe" instead of user's penName
  ghostAlias      String?
  viewCount       Int          @default(0)

  authorId        String
  author          User         @relation(fields: [authorId], references: [id], onDelete: Cascade)

  reactions       Reaction[]
  comments        Comment[]
  bookmarks       Bookmark[]
  whispers        WhisperConnection[]

  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([authorId])
  @@index([circleCategory])
  @@index([mood])
}

model Reaction {
  id        String   @id @default(uuid())
  storyId   String
  story     Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String   // FELT_THIS, VIRTUAL_HUG, INSPIRED, CATHARTIC, POETIC
  createdAt DateTime @default(now())

  @@unique([storyId, userId, type])
  @@index([storyId])
  @@index([userId])
}

model Comment {
  id               String   @id @default(uuid())
  storyId          String
  story            Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  content          String   @db.Text
  penNameSnapshot  String   // Pen name at the time of comment
  avatarIcon       String   @default("feather")
  avatarColor      String   @default("amber")
  isAuthor         Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([storyId])
  @@index([userId])
}

model Bookmark {
  id        String   @id @default(uuid())
  storyId   String
  story     Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([storyId, userId])
  @@index([userId])
}

model WhisperConnection {
  id           String           @id @default(uuid())
  storyId      String?
  story        Story?           @relation(fields: [storyId], references: [id], onDelete: SetNull)
  initiatorId  String
  initiator    User             @relation("SentWhispers", fields: [initiatorId], references: [id], onDelete: Cascade)
  recipientId  String
  recipient    User             @relation("ReceivedWhispers", fields: [recipientId], references: [id], onDelete: Cascade)
  status       String           @default("PENDING") // PENDING, ACCEPTED, DECLINED
  initialNote  String           @db.Text
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  messages     WhisperMessage[]

  @@index([initiatorId])
  @@index([recipientId])
  @@index([storyId])
}

model WhisperMessage {
  id           String            @id @default(uuid())
  connectionId String
  connection   WhisperConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  senderId     String
  sender       User              @relation(fields: [senderId], references: [id], onDelete: Cascade)
  content      String            @db.Text
  isRead       Boolean           @default(false)
  createdAt    DateTime          @default(now())

  @@index([connectionId])
  @@index([senderId])
}
